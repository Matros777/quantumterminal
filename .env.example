# ============================================
# Quantum Terminal - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# For Vercel: Add these in Project Settings → Environment Variables
# ============================================

# ===================
# REQUIRED FOR DEPLOY
# ===================

# MongoDB Database (REQUIRED for auth, community, etc.)
# Get free at: mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/quantumterminal
MONGODB_DB=quantumterminal

# ===================
# OPTIONAL - API KEYS
# ===================

# CoinGecko (free tier: 10-50 calls/min)
# Get at: coingecko.com/api
COINGECKO_API_KEY=

# Groq (AI features)
# Get at: console.groq.com
GROQ_API_KEY=

# ===================
# AUTHENTICATION
# ===================

# Session secret (REQUIRED if using auth)
# Generate: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-here

# Admin credentials (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# NextAuth (optional)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.vercel.app

# ===================
# OPTIONAL - FEATURES
# ===================

# Image uploads
IMGBB_API_KEY=

# SMTP for password reset (optional)
# If not set, reset links will be logged to console
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
MAIL_FROM="Quantum Terminal <no-reply@your-domain.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===================
# PUBLIC VARIABLES
# (Accessible from browser)
# ===================

NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ===================
# VERCEL DEPLOYMENT
# ===================

# Leave empty - Vercel handles these automatically
# NODE_ENV=production
# VERCEL_URL=
# VERCEL_GIT_PROVIDER=
# VERCEL_GIT_REPO_SLUG=
# VERCEL_GIT_REPO_OWNER=
